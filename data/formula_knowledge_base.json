        },
        "Aₐ": {
          "meaning": "换热站a供热面积",
          "unit": "m²",
          "time_info": ""
        },
        "(t=end - t=start)": {
          "meaning": "结束时间和起始时间的时间段内小时数",
          "unit": "小时h",
          "time_info": ""
        },
