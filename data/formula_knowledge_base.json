    "商河恒泰热源厂各月总燃气用量": {
      "formula": "total_gas_usage(month) = Σ_i [ G_end(i, month) - G_start(i, month) ]",
      "description": "计算商河恒泰热源厂在指定时段内各月份的总燃气用量。计算分为三个阶段：\n(1) 对厂区内每台燃气设备（包括锅炉与热泵），确定该设备在每个月的首尾观测时刻；\n(2) 分别取出对应时刻的累计燃气量读数，计算两者的差值作为该设备该月的用气量；\n(3) 对同月内所有设备的差值结果求和，得到厂区级的月度总燃气用量。结果为各月分别统计的总燃气用量，按月独立输出，不进行跨月汇总。\n异常与缺失处理规则：采用多层次的空值保护机制。首先，对月初和月末的累计值分别进行空值检查，若任一端为空则视为0；其次，对计算得到的差值本身也进行空值检查，若差值运算结果为空则同样视为0。这种层层保护的处理方式确保即使源数据缺失或中间计算异常，每台设备在每个月都能产生一个确定的数值（可能为0）参与最终汇总，避免空值传播导致整体结果失效。",
      "parameters": {
        "total_gas_usage(month)": {
          "meaning": "商河恒泰热源厂该月的总燃气用量（按月先设备求差再汇总）",
          "unit": "Nm³",
          "time_info": "按月统计（可能多月：如采暖季或各月时间范围为 11月15日至次年3月15日），各月独立，不跨月求和"
        },
        "G_end(i, month)": {
          "meaning": "设备 i 在该月最后一条记录的累计燃气量（空值时视为0）",
          "unit": "Nm³",
          "time_info": "当月末时刻"
        },
        "G_start(i, month)": {
          "meaning": "设备 i 在该月最早一条记录的累计燃气量（空值时视为0）",
          "unit": "Nm³",
          "time_info": "当月初时刻"
        },
        "i": {
          "meaning": "设备编号，包括锅炉和热泵",
          "unit": "无量纲",
          "time_info": ""
        }
      },
      
      "db_mapping": {
        "G(锅炉)": {
          "raw_description": "来自 ods_sc01_ntjt_zhgr_heat_boiler_inst_data 表中各锅炉（blr_id）的累计燃气量字段 blr_gas_total_hflow；",
          "table": "ods_sc01_ntjt_zhgr_heat_boiler_inst_data",
          "field": "blr_gas_total_hflow",
          "condition": "blr_id 为有效锅炉编号（1、2、3、4),时间也需按月筛选月末与月初",
          "note": "按月先计算每台锅炉的月末与月初累计量差值。计算时需要对月初值、月末值以及差值结果分别进行空值处理，确保任一环节出现空值时都能得到确定的数值0，最后对当月所有锅炉求和。"
        },
        "G(热泵)": {
          "raw_description": "来自 ods_sc01_ntjt_zhgr_heat_heatpump_inst_data 表中各热泵（pump_id）的累计燃气量字段 heatpump_total_gas；",
          "table": "ods_sc01_ntjt_zhgr_heat_heatpump_inst_data",
          "field": "heatpump_total_gas",
          "condition": "pump_id 为有效热泵编号（1、2),时间也需按月筛选月末与月初",
          "note": "按月先计算每台热泵的月末与月初累计量差值。计算时需要对月初值、月末值以及差值结果分别进行空值处理，确保任一环节出现空值时都能得到确定的数值0，最后对当月所有热泵求和。"

        }
      },
      "keywords": [
        "燃气用量",
        "总燃气用量",
        "商河恒泰热源厂",
        "商河恒泰",
        "供热季"
      ],
      "notes": [
        "计算顺序：先按设备在同月内求差（月末累计 - 月初累计），再在该月内对所有设备（锅炉+热泵）求和得到当月全厂用气；各月结果独立，不进行跨月汇总。",
        "时间范围可灵活设置，如采暖季或任意月份区间，但结果以月为单位分别输出。",
        "缺失与异常处理：实施多层次空值保护策略。第一层保护作用于原始数据读取阶段，对月初和月末的累计值分别进行空值检查，若为空则替换为0；第二层保护作用于差值计算结果，对减法运算的结果进行空值检查，若结果为空则同样替换为0。这种机制确保无论数据质量如何，每台设备在每个月都能贡献一个确定的数值参与汇总，防止空值在计算链中传播造成最终结果失效。"
      ]
    }
  }
}