          "meaning": "换热站a指定时段单位面积热单耗",
          "unit": "GJ/m²·季",
          "time_info": "指定时段"
        },
        "Qₐ(t=end)": {
          "meaning": "换热站a指定时段结束时间的一次侧累计热量",
          "unit": "GJ",
          "time_info": "2025年3月15日 0:00"
