    "热网指定时段热量损失率": {
      "formula": "NL = ((Q_source(t=end) - Q_source(t=start)) - (∑(Q_station_i(t=end) - Q_station_i(t=start)))) / (Q_source(t=end) - Q_source(t=start)) × 100%\n",
      "description": "供热网损率是指在供热系统中，由于管网散热、管道泄漏等原因导致的热量损失占总供热量的比例。\n它是衡量供热管网运行效率和节能水平的重要指标，网损率越低，说明供热系统的热量利用效率越高，能源浪费越少。\n网损率 = (热网供热量-∑换热站用热量)/热网供热量*100%\n热网供热量：供热系统从热源输出的总热量，单位吉焦（GJ）。\n换热站供热量：有效供热量，最终输送到用户端并被实际利用的热量，即用户实际接收的热量。",
      "parameters": {
        "NL": {
          "meaning": "热网指定时段热量损失率（Net Loss），单位100%；",
          "unit": "%",
          "time_info": "指定时段"
        },
        "Q_source": {
          "meaning": "热源厂累计热量",
          "unit": "GJ",
          "time_info": ""
        },
        "Q_station_i": {
          "meaning": "换热站id为i的换热站累计热量",
          "unit": "GJ",
          "time_info": ""
        },
        "∑(Q_station_i(t=end) - Q_station_i(t=start))": {
          "meaning": "所有换热站的指定时段累计热量差值之和，i为换热站id，需计算所有不同id的换热站的指定时段累计热量差值之和",
          "unit": "GJ",
          "time_info": "指定时段"
        },
        "t": {
          "meaning": "时间",
          "unit": "",
          "time_info": ""
        }
      },
      "db_mapping": {
        "Q_source": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_source_inst_data表中src_id为1的src_sup_total_hheat；",
          "table": "ods_sc01_ntjt_zhgr_heat_source_inst_data",
          "field": "src_sup_total_hheat",
          "condition": "src_id = 1",
          "note": ""
        },
        "Q_station_i": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_station_inst_data表stn_id为i的stn_prim_total_hheat；",
          "table": "ods_sc01_ntjt_zhgr_heat_station_inst_data",
          "field": "stn_prim_total_hheat",
          "condition": "stn_id = i",
          "note": "i为换热站id，需遍历所有不同的stn_id"
        },
        "t": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_station_inst_data表data_time",
          "table": "ods_sc01_ntjt_zhgr_heat_station_inst_data",
          "field": "data_time",
          "condition": "",
          "note": "用于确定指定时段的起始时间(t=start)和结束时间(t=end)"
        }
      },
      "keywords": [
        "采暖季",
        "供暖季",
        "供热季",
        "热量",
        "损失率",
        "热网"
      ],
      "notes": []
    },
    "换热站指定时段电单耗": {
