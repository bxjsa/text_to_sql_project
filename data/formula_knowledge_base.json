{
  "formulas": {
    "热源厂采暖季热单耗": {
      "formula": "q = (Q(t=end) - Q(t=start)) / A * 24 * 120 / ((t=end - t=start) + 1)",
      "description": "采暖季内，整个供热系统的单位建筑面积或单位供热量所消耗的热量，用于衡量供热系统的能源利用效率和节能水平。\n用采暖季结束时的累计热量 减去 采暖季开始时的累计热量 结果除以 整个热网总供热面积。",
      "parameters": {
        "q": {
          "meaning": "水网单位面积热单耗",
          "unit": "GJ/㎡·季",
          "time_info": ""
        },
        "Q(t=end)": {
          "meaning": "热源采暖季结束时的累计热量",
          "unit": "GJ",
          "time_info": "2025年3月15日 0:00"
        },
        "Q(t=start)": {
          "meaning": "热源采暖季起始时的累计热量",
          "unit": "GJ",
          "time_info": "2024年11月15日 0:00"
        },
        "(Q(t=end) - Q(t=start))": {
          "meaning": "热源厂采暖季的总耗热量/产热量/累计热量",
          "unit": "",
          "time_info": ""
        },
        "A": {
          "meaning": "热网总供热面积",
          "unit": "㎡",
          "time_info": ""
        },
        "(t=end - t=start)": {
          "meaning": "结束时间和起始时间的时间段内小时数",
          "unit": "",
          "time_info": ""
        }
      },
      "db_mapping": {
        "Q": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_source_inst_data表中src_id分别为1和2的src_sup_total_hheat；src_id=1的是商河恒泰热源厂，src_id=2是玉泉生物质电厂，若未明确指出哪个热源厂的指标计算，那么热源厂热单耗需要计算两个热源总和的热单耗，总热量需要分别计算src_id为1和2的累计热量的差值，再汇总得到热源厂总热量；因为不同热源src_id的数据data_time不相同，统计热量时不同src_id要分别获取起始时间和结束时间；",
          "table": "ods_sc01_ntjt_zhgr_heat_source_inst_data",
          "field": "src_sup_total_hheat",
          "condition": "src_id IN (1, 2)",
          "note": "src_id=1的是商河恒泰热源厂，src_id=2是玉泉生物质电厂，若未明确指出哪个热源厂的指标计算，那么热源厂热单耗需要计算两个热源总和的热单耗，总热量需要分别计算src_id为1和2的累计热量的差值，再汇总得到热源厂总热量；因为不同热源src_id的数据data_time不相同，统计热量时不同src_id要分别获取起始时间和结束时间；"
        },
        "A": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_station_info表中所有stn_id的heat_area之和；",
          "table": "ods_sc01_ntjt_zhgr_heat_station_info",
          "field": "heat_area",
          "condition": "",
          "note": "对所有heat_area进行汇总/求和，并且需要包含所有stn_id"
        }
      },
      "keywords": [
        "热单耗",
        "采暖季",
        "产热量",
        "热源厂"
      ],
      "notes": []
    },
    "热源厂供暖季热单耗": {
      "formula": "q = (Q(t=end) - Q(t=start)) / A × (24 × 120) / ((t=end - t=start) + 1)",
      "description": "步骤一：供暖季热单耗，是通过结束时间累计热量 - 起始时间累计热量的结果，除以问题热源厂的总供热面积。\n步骤二：步骤一结果要转换成供暖季量级，需要将上述结果，按照小时粒度，计算从开始时间到结束时间有多少小时。并将步骤一结果除以小时数，在乘以24（每天的小时数）和 120（供暖季的天数）\n#要记住!!，只有做了步骤二，生成的热单耗单位才是：GJ/㎡·季， 如果没有做步骤二，单位是：GJ/㎡",
      "parameters": {
        "q": {
          "meaning": "水网单位面积热单耗",
          "unit": "GJ/㎡·季",
          "time_info": ""
        },
        "Q(t=end)": {
          "meaning": "热源供暖季结束时的累计热量",
          "unit": "GJ",
          "time_info": ""
        },
        "Q(t=start)": {
          "meaning": "热源供暖季起始时的累计热量",
          "unit": "GJ",
          "time_info": ""
        },
        "A": {
          "meaning": "热网总供热面积",
          "unit": "㎡",
          "time_info": ""
        },
        "(t=end - t=start)": {
          "meaning": "结束时间和起始时间的时间段内小时数",
          "unit": "小时H",
          "time_info": ""
        },
        "(Q(t=end) - Q(t=start))": {
          "meaning": "热源厂供暖季的总耗热量/产热量/累计热量",
          "unit": "",
          "time_info": ""
        },
        "t": {
          "meaning": "时间；",
          "unit": "",
          "time_info": ""
        }
      },
      "db_mapping": {
        "Q": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_source_inst_data表中src_id分别为1和2的src_sup_total_hheat；src_id=1的是商河恒泰热源厂，src_id=2是玉泉生物质电厂，若未明确指出哪个热源厂的指标计算，那么热源厂热单耗需要计算两个热源总和的热单耗，总热量需要分别计算src_id为1和2的累计热量的差值，再汇总得到热源厂总热量；因为不同热源src_id的数据data_time不相同，统计热量时不同src_id要分别获取起始时间和结束时间；",
          "table": "ods_sc01_ntjt_zhgr_heat_source_inst_data",
          "field": "src_sup_total_hheat",
          "condition": "src_id IN (1, 2)",
          "note": "需要分别计算不同src_id的值; 需要对结果进行汇总/求和; 不同src_id的起始/结束时间需分别获取"
        },
        "A": {
          "raw_description": "ods_sc01_ntjt_zhgr_heat_station_info表中所有stn_id的heat_area之和；",
          "table": "ods_sc01_ntjt_zhgr_heat_station_info",
          "field": "heat_area",
          "condition": "",
          "note": "需要对heat_area进行汇总/求和，并包含所有stn_id"
        }
      },
      "keywords": [
        "热单耗",
        "供暖季",
        "产热量",
        "热源厂"
      ],
      "notes": []
    },
